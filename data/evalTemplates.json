        "max": 0
      }
    ],
    "promotion": [
      {
        "label": "외부 홍보 실적",
        "method": "(학과 홍보실적 건수 * 0.3점)\n*사업명과 학과명 필수 기재",
        "max": 10
      },
      {
        "label": "관련 업체 MOU 체결 실적 및 활동",
        "method": "(MOU 체결 후 사업 건수 * 2점)\n* MOU후 실제 실적 건수가 있어야함",
        "max": 10
      }
    ],
    "bonus": [
      {
        "label": "우수사례 구체적 실적\n(최대3점)",
        "method": "1. 학과 관련 법인채택 우수사례(0.5점/건)\n2. 전국단위 공모전 입상 (캠퍼스별 단위 공모전 제외)(0.5점/건)",
        "max": "(+3)"
      },
      {
        "label": "단기과정 운영(최대5점)",
        "method": "1. 중장년특화과정(집중1, 집중2)\n2. 여성재취업훈련\n3. 이주배경구직자직업훈련\n4. AX과정\n  (1점/건)",
        "max": "(+5)"
      },
      {
        "label": "AI교과 운영(최대2점)",
        "method": "1. 산업AI교과 편성 및 개설  (1점/건)",
        "max": "(+3)"
      },
      {
        "label": "고가장비활용 실적(1,000만원이상)\n(5점)",
        "method": "1. 주 담당교원외 학과 교원들의 고가장비 활용 사례 \n2. 고가 장비 활용 내.외부 연수 운영 사례\n   (1점/건)",
        "max": "(+5)"
      }
    ],
    "penalty": [
      {
        "label": "장비도입",
        "method": "1. 계획대비 장비 개강일 기준 미도입 건수\n   (장비계약 건당 1점 감점)",
        "max": "(-3)"
      },
      {
        "label": "부적절 행위 감점",
        "method": "성관련, 직장내 괴롭힘, 갑질, 학생민원, 기관 브랜드 이미지에 역행하는 경우(최대 5점)",
        "max": "(-5)"
      }
    ],
